# Supabase Postgres — pooled connection (used by the app at runtime)
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Supabase Postgres — direct connection (used only for `prisma migrate`)
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Project settings -> API
SUPABASE_URL="https://xxxx.supabase.co"
# Project settings -> API -> service_role secret (server-only, never expose to the frontend)
SUPABASE_SERVICE_ROLE_KEY="xxxx"
# Storage bucket used for uploaded files (create it once, see README)
SUPABASE_STORAGE_BUCKET="data-room-files"

PORT=4000
# Frontend origin allowed to call this API
CORS_ORIGIN="http://localhost:5173"
